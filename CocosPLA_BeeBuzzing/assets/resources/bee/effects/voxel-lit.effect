// Lightweight stylized lit effect for the voxel sculpture, flying cubes, bees and hives.
// - No scene lights needed: a fixed key light + hemisphere ambient computed in the shader.
// - USE_VERTEX_COLOR: per-cube palette color baked into the merged sculpture mesh.
// - USE_EDGE: darkens face borders (per-face UV 0..1) for the beveled "pixel cube" look.
// - USE_INSTANCING (engine macro): bees / flying cubes sharing a material draw in one batch.
CCEffect %{
  techniques:
  - name: opaque
    passes:
    - vert: voxel-vs:vert
      frag: voxel-fs:frag
      properties: &props
        mainColor:    { value: [1, 1, 1, 1], linear: true, editor: { type: color } }
        mainTexture:  { value: white, editor: { parent: USE_TEXTURE } }
        lightParams:  { value: [0.35, 0.85, 0.55, 0.42], editor: { tooltip: 'xyz: key light direction, w: ambient' } }
        edgeParams:   { value: [0.12, 0.38, 0.0, 0.0], editor: { parent: USE_EDGE, tooltip: 'x: edge width (uv), y: edge darkness' } }
        emissive:     { value: [0, 0, 0, 0], linear: true, editor: { type: color, tooltip: 'rgb added after shading (hit flash)' } }
  - name: transparent
    passes:
    - vert: voxel-vs:vert
      frag: voxel-fs:frag
      depthStencilState: { depthTest: true, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties: *props
}%

CCProgram voxel-vs %{
  precision highp float;
  #include <legacy/input>
  #include <builtin/uniforms/cc-global>
  #include <legacy/decode-base>
  #include <legacy/local-batch>

  #if USE_VERTEX_COLOR
    in lowp vec4 a_color;
    out lowp vec4 v_color;
  #endif

  out vec3 v_normal;
  out vec2 v_uv;

  vec4 vert () {
    vec4 position;
    CCVertInput(position);

    mat4 matWorld, matWorldIT;
    CCGetWorldMatrixFull(matWorld, matWorldIT);

    v_normal = normalize((matWorldIT * vec4(a_normal, 0.0)).xyz);
    v_uv = a_texCoord;
    #if USE_VERTEX_COLOR
      v_color = a_color;
    #endif

    return cc_matProj * (cc_matView * matWorld) * position;
  }
}%

CCProgram voxel-fs %{
  precision highp float;
  #include <legacy/output-standard>

  in vec3 v_normal;
  in vec2 v_uv;

  #if USE_VERTEX_COLOR
    in lowp vec4 v_color;
  #endif

  #if USE_TEXTURE
    uniform sampler2D mainTexture;
  #endif

  uniform Constant {
    vec4 mainColor;
    vec4 lightParams;
    vec4 edgeParams;
    vec4 emissive;
  };

  vec4 frag () {
    vec4 o = mainColor;

    #if USE_VERTEX_COLOR
      o.rgb *= SRGBToLinear(v_color.rgb);
      o.a *= v_color.a;
    #endif

    #if USE_TEXTURE
      vec4 texColor = texture(mainTexture, v_uv);
      texColor.rgb = SRGBToLinear(texColor.rgb);
      o *= texColor;
    #endif

    #if USE_EDGE
      vec2 e = min(v_uv, 1.0 - v_uv);
      float edge = smoothstep(0.0, edgeParams.x, min(e.x, e.y));
      o.rgb *= mix(1.0 - edgeParams.y, 1.0, edge);
    #endif

    vec3 N = normalize(v_normal);
    vec3 L = normalize(lightParams.xyz);
    float ndl = max(dot(N, L), 0.0);
    float hemi = 0.5 + 0.5 * N.y;
    float ambient = lightParams.w;
    o.rgb *= ambient + (1.0 - ambient) * (0.7 * ndl + 0.3 * hemi);
    o.rgb += emissive.rgb;

    return CCFragOutput(o);
  }
}%
